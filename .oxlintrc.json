{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import", "promise"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "browser": true,
    "es2026": true
  },
  "ignorePatterns": ["dist/", "node_modules/", "**/*.d.ts"]
}
