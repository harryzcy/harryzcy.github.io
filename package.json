{
  "name": "harryzcy.github.io",
  "type": "module",
  "description": "This is where my website stays",
  "author": "Chongyi Zheng",
  "license": "UNLICENSED",
  "scripts": {
    "start": "parcel './src/*.html'",
    "build": "npm run build:parcel && npm run build:copy",
    "build:parcel": "parcel build",
    "build:copy": "cp -R src/.well-known dist && cp src/projects.yaml dist && cp cloudflare/* dist",
    "analyze": "parcel build --reporter @parcel/reporter-bundle-analyzer",
    "check": "vue-tsc --noEmit",
    "lint": "eslint src",
    "prettier": "prettier src --write",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "source": [
    "src/index.html",
    "src/projects.html"
  ],
  "targets": {
    "default": {
      "distDir": "./dist"
    }
  },
  "homepage": "https://github.com/harryzcy/harryzcy.github.io#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "@parcel/packager-raw-url": "2.16.4",
    "@parcel/reporter-bundle-analyzer": "2.16.4",
    "@parcel/transformer-vue": "2.16.4",
    "@parcel/transformer-webmanifest": "2.16.4",
    "@parcel/transformer-yaml": "2.16.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "autoprefixer": "10.5.4",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "parcel": "2.16.4",
    "postcss": "8.5.25",
    "postcss-import": "16.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "process": "0.11.10",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.8"
  },
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40"
  }
}
